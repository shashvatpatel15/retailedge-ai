# ============================================
# EDGE AI (PI 3 B+ / LIGHTWEIGHT RUNTIME)
# ============================================

CAMERA_SOURCE=0
# Or for network/IP camera: CAMERA_SOURCE=http://PHONE_IP:8080/video

DETECTOR_BACKEND=ncnn
# Options: "ncnn" (recommended for Raspberry Pi 3 B+) or "yolo"

YOLO_MODEL=yolo11n_ncnn_model
# For NCNN: yolo11n_ncnn_model | For Ultralytics: yolo11n.pt

YOLO_IMAGE_SIZE=320
# 320 is optimal for Pi 3 B+ inference speed

NCNN_NUM_THREADS=4

PERSON_CONFIDENCE=0.40


# ============================================
# DEVICE
# ============================================

EDGE_DEVICE_ID=edge-01


# ============================================
# SUPABASE CLOUD SYNC
# ============================================

SUPABASE_INGEST_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-queue
SUPABASE_HISTORY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/queue-history
EDGE_INGEST_TOKEN=YOUR_PRIVATE_TOKEN

CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_INTERVAL_SECONDS=10
CLOUD_SYNC_BATCH_SIZE=20