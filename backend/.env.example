# ============================================
# CLOUD SYNC / SUPABASE CONFIGURATION
# ============================================

# Supabase Edge Function URL for Ingestion
SUPABASE_INGEST_URL=https://your-project-id.supabase.co/functions/v1/clever-handler

# Supabase Edge Function URL for History Analytics
SUPABASE_HISTORY_URL=https://your-project-id.supabase.co/functions/v1/queue-history

# Edge Device Ingestion Token
EDGE_INGEST_TOKEN=your_edge_device_ingest_token_here

# Identifier for this edge node / store camera
EDGE_DEVICE_ID=edge-01


# ============================================
# SYNC WORKER CONFIGURATION
# ============================================

# Toggle cloud synchronization (true/false)
CLOUD_SYNC_ENABLED=false

# Sync interval in seconds
CLOUD_SYNC_INTERVAL_SECONDS=10

# Max records per sync batch
CLOUD_SYNC_BATCH_SIZE=20
