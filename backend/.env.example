# ============================================
# EDGE AI
# ============================================

CAMERA_SOURCE=http://PHONE_IP:8080/video

YOLO_MODEL=yolo11n.pt

YOLO_IMAGE_SIZE=640

PERSON_CONFIDENCE=0.40


# ============================================
# DEVICE
# ============================================

EDGE_DEVICE_ID=edge-01


# ============================================
# SUPABASE
# ============================================

SUPABASE_INGEST_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-queue

SUPABASE_HISTORY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/queue-history

EDGE_INGEST_TOKEN=YOUR_PRIVATE_TOKEN


# ============================================
# CLOUD SYNC
# ============================================

CLOUD_SYNC_ENABLED=true

CLOUD_SYNC_INTERVAL_SECONDS=10

CLOUD_SYNC_BATCH_SIZE=20